# Local agent and IDE state
/.claude/
/.codex/
/.agents/
/.vs/

# 에이전트 격리 워크트리. 이 워크벤치는 sync 도구가 `git add -A` 하는 곳이라,
# 여기 놓인 다른 레포의 워크트리는 gitlink(160000)로 공개 히스토리에 실려 나간다.
# 실제로 2026-08-23 에 AgentSessionVault 워크트리가 그렇게 커밋됐다.
/.worktrees/

# Projects/ 하위 프로젝트 폴더(미러 baseline·편집본·테스트 산출물)는 로컬 전용.
# 단, 공개 예시 매니페스트만 추적한다. 실제 Projects/projects.json 은 로컬 전용.
/Projects/*/
/Projects/projects.json
!/Projects/projects.example.json

# 옛 루트 미러 잔재 방어: 미러는 Projects/<name>/baseline 으로 이동했다.
# 루트엔 다시 생기지 않지만, 다른 머신에 남은 옛 레이아웃 미러가 추적되는 footgun을 막는다.
/CyphenEngine/
/Modules/
/CyphenBuild.props

# Local build and scratch artifacts
/BuildArtifacts/
/Temp/
*.user
*.log
*.stackdump

# Optional machine-specific configuration
/local.settings.psd1
/WorkbenchStateSync.local.psd1
/AgentSessionSync.local.psd1
/Packages/WorkbenchStateSync/workbenchstatesync.config.psd1
/Packages/AgentSessionSync/agentsessionsync.config.psd1

# Local user settings. Keep only the public guide and registry example tracked.
# The real registry (UserSettings/sync-tools.json) may hold machine-local absolute
# paths and must stay ignored.
/UserSettings/**
!/UserSettings/
!/UserSettings/README.md
!/UserSettings/sync-tools.example.json

# Actual cross-review instances are private working records.
# Keep only the public review framework and template in this repository.
/Reviews/*/
!/Reviews/_TEMPLATE/
!/Reviews/_TEMPLATE/**
